{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=postgres;Port=5432;Database=ShopDb;Username=shopuser;Password=CHANGE_THIS_STRONG_PASSWORD"
  },
  "Jwt": {
    "Issuer": "Shop.Api",
    "Audience": "Shop.Clients",
    "Secret": "REPLACE_WITH_ENVIRONMENT_VARIABLE",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Payment": {
    "DefaultGateway": "ZarinPal",
    "CallbackBaseUrl": "https://barzinpart.ir",
    "FrontendResultUrl": "https://barzinpart.ir/payment/result",
    "EnableFakeGateway": false,
    "ZarinPal": { "Enabled": true, "MerchantId": "", "Sandbox": true }
  },
  "Storage": { "RequestPath": "/uploads" },
  "Cors": { "AllowedOrigins": [
    "barzinpart.ir"
  ] },
  "RateLimit": { "GlobalPerMinute": 300, "AuthPerMinute": 10 },
  "Swagger": { "Enabled": false },
  "Seed": { 
    "AdminEmail": "admin@barzinpart.ir",
     "AdminPassword": "REPLACE_WITH_STRONG_ADMIN_PASSWORD",
      "SampleData": false }
}
